            "types": "./dist/runtime/core/index.d.mts",
            "import": "./dist/runtime/core/index.mjs"
          }
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/module.d.mts"
      },
      "declared_commands": {
        "build": "node scripts/build.mts",
        "typecheck": "pnpm run build && vue-tsc --noEmit -p tsconfig.json",
        "test": "pnpm run build && node --test test/*.test.mts",
        "prepack": "pnpm run typecheck && pnpm test && pnpm run build"
      }
    }
  ],
