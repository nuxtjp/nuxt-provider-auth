{
  "name": "@nuxtjp/provider-auth",
  "version": "0.1.0",
  "description": "Provider-neutral external-service authentication UI for Nuxt",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10 <11"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "repository.toml",
    "NOTICE",
    "LICENSE-PREVIOUS"
  ],
  "main": "./src/module.mjs",
  "types": "./src/module.d.ts",
  "exports": {
    ".": {
      "types": "./src/module.d.ts",
      "import": "./src/module.mjs"
    },
    "./core": {
      "types": "./src/runtime/core/index.d.ts",
      "import": "./src/runtime/core/index.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm test"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.5.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.0",
    "@nuxt/schema": "^4.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
