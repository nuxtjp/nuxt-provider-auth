{
  "name": "@nuxtjp/provider-auth",
  "version": "0.1.1",
  "description": "Provider-neutral external-service authentication UI for Nuxt",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=10 <11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "repository.toml",
    "NOTICE",
    "LICENSE-PREVIOUS"
  ],
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./core": {
      "types": "./dist/runtime/core/index.d.mts",
      "import": "./dist/runtime/core/index.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "pnpm run build && vue-tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mts",
    "prepack": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.5.0",
    "@nuxt/schema": "^4.5.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@nuxt/kit": "4.5.0",
    "@nuxt/schema": "4.5.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue": "3.5.43",
    "vue-tsc": "3.2.8"
  }
}
